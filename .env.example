# YouTube Data API v3 Key
# Obtén tu clave en https://console.cloud.google.com/apis/library/youtube.googleapis.com
# Copia este archivo a .env y reemplaza con tu clave real:
EXPO_PUBLIC_YOUTUBE_API_KEY=TU_CLAVE_DE_API_AQUI

# Evita que EAS CLI se quede bloqueado calculando el fingerprint en Windows durante la build
EAS_SKIP_AUTO_FINGERPRINT=1
